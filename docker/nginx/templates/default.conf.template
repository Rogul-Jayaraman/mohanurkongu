upstream backend {
    server ${BACKEND_HOST}:${BACKEND_PORT};
}

upstream frontend {
    server ${FRONTEND_HOST}:${FRONTEND_PORT};
}

worker_processes auto;

server {
    listen 80;

    # ── Rate Limiting ────────────────────────────────────────────────
    limit_req_zone $binary_remote_addr zone=global:10m rate=50r/s;

    # ── Compression ──────────────────────────────────────────────────
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_vary on;
    gzip_min_length 256;

    # ── Security Headers ─────────────────────────────────────────────
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://inputtools.google.com; frame-ancestors 'none'; base-uri 'self'" always;

    # ── SPA ─────────────────────────────────────────────────────────
    location / {
        limit_req zone=global burst=100 nodelay;
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (Vite HMR)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ── Static Assets (immutable cache) ─────────────────────────────
    location /assets/ {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── API ─────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Robots & Sitemap ────────────────────────────────────────────
    location = /robots.txt {
        proxy_pass http://frontend;
        expires 1d;
        add_header Cache-Control "public, must-revalidate";
    }

    location = /sitemap.xml {
        proxy_pass http://frontend;
        expires 1d;
        add_header Cache-Control "public, must-revalidate";
    }

    # ── Media Direct Serving ────────────────────────────────────────
    # Serves uploaded images directly from disk.
    # No Node, no DB, no auth, no redirect.
    # Files stored at /storage/media/{objectKey}
    location /media/ {
        alias /storage/media/;

        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        etag on;

        open_file_cache max=50000 inactive=300s;
        open_file_cache_valid 120s;
        open_file_cache_min_uses 2;

        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";

        try_files $uri =404;
    }
}
