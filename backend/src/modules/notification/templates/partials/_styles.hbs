<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Poppins:wght@400;500;700&family=Noto+Sans+Tamil:wght@400;500;600;700&display=swap');

  :root {
    color-scheme: light only;
  }

  * { margin: 0; padding: 0; }
  body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }
  td { font-family: 'Poppins', 'Noto Sans Tamil', Arial, sans-serif; }
  img { border: 0; outline: none; text-decoration: none; display: block; }
  a { text-decoration: none; }

  .ta-heading  { font-family: 'Noto Sans Tamil', Arial, sans-serif; font-weight: 600; font-size: 24px; line-height: 1.6; color: #4A4038; }
  .ta-body     { font-family: 'Noto Sans Tamil', Arial, sans-serif; font-weight: 500; font-size: 16px; line-height: 1.7; color: #4A4038; }
  .en-heading  { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: 22px; line-height: 1.3; color: #4A4038; }
  .en-body     { font-family: 'Poppins', Arial, sans-serif; font-weight: 400; font-size: 14px; line-height: 1.5; color: #4A4038; }
  .small-text  { font-family: 'Poppins', Arial, sans-serif; font-weight: 400; font-size: 12px; line-height: 1.4; }
  .text-secondary { color: #6D6258; }
  .text-gold   { color: #C9A227; }
  .text-success { color: #4F7D59; }
  .text-warning { color: #B56A45; }
  .text-alert  { color: #A63B3B; }
  .text-white  { color: #FFFFFF; }

  @media (max-width: 600px) {
    .container  { width: 100% !important; max-width: 100% !important; }
    .content    { padding: 24px 20px !important; }
    .card       { padding: 24px 20px !important; }
    .ta-heading { font-size: 20px !important; }
    .en-heading { font-size: 18px !important; }
    .ta-body    { font-size: 15px !important; }
    .en-body    { font-size: 13px !important; }
    .otp-code   { font-size: 36px !important; letter-spacing: 4px !important; }
    .header-pad { padding: 28px 24px 24px !important; }
    .footer-pad { padding: 24px 20px !important; }
    .cta-table  { width: 100% !important; }
    .cta-td     { display: block !important; text-align: center !important; }
    .cta-a      { display: block !important; padding: 14px 24px !important; font-size: 14px !important; }
    .logo       { width: 64px !important; height: 64px !important; }
    .greeting-icon { width: 36px !important; height: 36px !important; }
  }
</style>
