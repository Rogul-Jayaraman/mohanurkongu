        <tr>
          <td align="center" style="padding: 24px 20px;">
            <span class="otp-code" style="font-family: 'Courier New', Courier, monospace; font-size: 52px; font-weight: 700; color: #86143A; letter-spacing: 12px; line-height: 1; display: block; text-align: center;">
              {{code}}
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
