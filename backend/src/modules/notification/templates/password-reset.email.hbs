<!DOCTYPE html>
<html lang="ta" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Reset Your Password</title>
  {{> _styles}}
</head>
<body style="margin: 0; padding: 0; background-color: #F8F6F1; -webkit-font-smoothing: antialiased;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F8F6F1; min-width: 100%;">
    <tr>
      <td align="center" style="padding: 40px 10px;">
        <!--[if mso]>
        <table width="600" cellpadding="0" cellspacing="0" border="0" align="center">
          <tr><td>
        <![endif]-->
        <table width="100%" class="container" style="max-width: 600px; background-color: #FCFAF6; border-radius: 12px; box-shadow: 0 2px 12px rgba(74,64,56,0.06);" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td>
              {{> header}}

              {{> greeting
                  icon='<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="16" fill="#C9A227" opacity="0.15"/><circle cx="20" cy="22" r="7" fill="#C9A227" opacity="0.4"/><circle cx="20" cy="22" r="3" fill="#C9A227"/><path d="M20 19V16m0 0V13a2 2 0 014 0v3m-4-3h4" stroke="#C9A227" stroke-width="1.5" stroke-linecap="round"/></svg>'
                  taHeading='கடவுச்சொல்லை மீட்டமைக்கவும்'
                  enHeading='Reset Your Password'
              }}

              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="content card" style="padding: 0 40px 32px;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #FCFAF6; border-radius: 12px;">
                      <tr>
                        <td class="card" style="padding: 32px;">
                          <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td class="ta-body" style="padding-bottom: 12px;">
                                உங்கள் கணக்கிற்கான கடவுச்சொல் மீட்டமைப்புக் கோரிக்கையைப் பெற்றுள்ளோம். கடவுச்சொல்லை மீட்டமைக்க கீழே உள்ள பொத்தானைக் கிளிக் செய்யவும்.
                              </td>
                            </tr>
                            <tr>
                              <td class="en-body" style="padding-bottom: 4px;">
                                We received a request to reset the password for your account. Click the button below to reset it.
                              </td>
                            </tr>
                          </table>

                          {{> cta-button
                              taText='கடவுச்சொல்லை மீட்டமை'
                              enText='Reset Password'
                              href=resetUrl
                          }}

                          <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center" style="padding-top: 16px;">
                                <span class="small-text text-warning" style="font-family: 'Poppins', 'Noto Sans Tamil', Arial, sans-serif;">
                                  ⏱ <span style="font-family: 'Noto Sans Tamil', Arial, sans-serif;">15 நிமிடங்களில் காலாவதியாகும்</span> / This link expires in 15 minutes
                                </span>
                              </td>
                            </tr>
                          </table>

                          {{> info-note
                              borderColor='#6D6258'
                              textColor='#4A4038'
                              taText='இதை நீங்கள் கோரவில்லையா? இந்த மின்னஞலைப் புறக்கணிக்கவும். உங்கள் கடவுச்சொல் மாற்றப்படாது.'
                              enText="Didn't request this? Ignore this email. Your password won't be changed."
                          }}
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              {{> footer}}
            </td>
          </tr>
        </table>
        <!--[if mso]>
          </td></tr>
        </table>
        <![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
