<!DOCTYPE html>
<html lang="ta" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Verify Your Email</title>
  {{> _styles}}
</head>
<body style="margin: 0; padding: 0; background-color: #F8F6F1; -webkit-font-smoothing: antialiased;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #F8F6F1; min-width: 100%;">
    <tr>
      <td align="center" style="padding: 40px 10px;">
        <!--[if mso]>
        <table width="600" cellpadding="0" cellspacing="0" border="0" align="center">
          <tr><td>
        <![endif]-->
        <table width="100%" class="container" style="max-width: 600px; background-color: #FCFAF6; border-radius: 12px; box-shadow: 0 2px 12px rgba(74,64,56,0.06);" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td>
              {{> header}}

              {{> greeting
                  icon='<svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="20" cy="20" r="16" fill="#C9A227" opacity="0.15"/><rect x="8" y="13" width="24" height="16" rx="2" fill="#C9A227" opacity="0.6"/><path d="M8 14L20 22L32 14" stroke="#C9A227" stroke-width="2" fill="none"/></svg>'
                  taHeading='மின்னஞலைச் சரிபார்க்கவும்'
                  enHeading='Verify Your Email'
              }}

              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="content card" style="padding: 0 40px 32px;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #FCFAF6; border: 1px solid #E2D4B4; border-radius: 12px;">
                      <tr>
                        <td class="card" style="padding: 32px;">
                          <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td class="ta-body" style="padding-bottom: 12px;">
                                உங்கள் மின்னஞலைச் சரிபார்க்க கீழே உள்ள பொத்தானைக் கிளிக் செய்யவும். இந்த இணைப்பு 15 நிமிடங்களில் காலாவதியாகும்.
                              </td>
                            </tr>
                            <tr>
                              <td class="en-body" style="padding-bottom: 4px;">
                                Click the button below to verify your email address. This link expires in 15 minutes.
                              </td>
                            </tr>
                          </table>

                          {{> cta-button
                              taText='மின்னஞலைச் சரிபார்'
                              enText='Verify Email'
                              href=verifyUrl
                          }}

                          <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center" style="padding-top: 16px;">
                                <span style="font-family: 'Poppins', 'Noto Sans Tamil', Arial, sans-serif; font-size: 12px; font-weight: 400; color: #6D6258;">
                                  <span style="font-family: 'Noto Sans Tamil', Arial, sans-serif;">🔒 உங்கள் கணக்கின் பாதுகாப்பை உறுதிப்படுத்த இது அவசியம்.</span><br>
                                  This is required to secure your account.
                                </span>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="padding: 0 40px 32px;">
                    <span class="small-text text-warning" style="font-family: 'Poppins', 'Noto Sans Tamil', Arial, sans-serif;">
                      ⏱ <span style="font-family: 'Noto Sans Tamil', Arial, sans-serif;">15 நிமிடங்களில் காலாவதியாகும்</span> / Expires in 15 minutes
                    </span>
                  </td>
                </tr>
              </table>

              {{> footer}}
            </td>
          </tr>
        </table>
        <!--[if mso]>
          </td></tr>
        </table>
        <![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
