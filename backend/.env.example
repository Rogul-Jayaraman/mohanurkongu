# =============================================================================
# Mohanurkongu — Backend Environment Variables
# =============================================================================
# Usage:
#   For development:  cp .env.example .env       (then edit .env)
#   For production:   cp .env.example .env.prod   (then edit .env.prod)
#
# NEVER commit .env or .env.prod to git.
# =============================================================================


# ===== REQUIRED SECRETS =====
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_VERIFICATION_SECRET=CHANGE_ME
JWT_RESET_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME


# ===== DATABASE =====
# Docker host = 'postgres' (Docker service name).
# Dev host = 'localhost:5433' (mapped from Docker port 5433).
# Prod: postgresql://user:pass@postgres:5432/dbname?schema=public
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASS@postgres:5432/CHANGE_ME_DB?schema=public


# ===== REDIS =====
# In Docker: host must be the Docker service name ('redis', 'redis-cache').
# Password is required in production (compose has --requirepass).
# In dev without Docker: no password, host=localhost.
REDIS_QUEUE_HOST=CHANGE_ME
REDIS_QUEUE_PASSWORD=CHANGE_ME
REDIS_CACHE_HOST=CHANGE_ME
REDIS_CACHE_PASSWORD=CHANGE_ME


# ===== EMAIL (SMTP) =====
# Dev:  localhost:1025 (Mailpit — no auth)
# Prod: smtp.sendgrid.net:587 (or your provider)
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@CHANGE_ME_DOMAIN.com


# ===== DOMAIN & CORS =====
APP_URL=http://CHANGE_ME:5173
CORS_ORIGIN=http://CHANGE_ME:5173


# ===== DOCKER INFRASTRUCTURE =====
# These are read by compose services via env_file.
# For dev: defaults below match Docker containers.
# For prod: change the password and domain.
POSTGRES_USER=mohanurkongu
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mohanurkongu
DOMAIN_NAME=CHANGE_ME
CERTBOT_EMAIL=admin@CHANGE_ME_DOMAIN


# ===== SENTRY (optional — delete if not used) =====
# SENTRY_DSN=https://key@o123.ingest.sentry.io/123
# SENTRY_TRACES_SAMPLE_RATE=0.1
