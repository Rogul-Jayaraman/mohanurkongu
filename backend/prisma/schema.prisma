generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
}

enum LanguageCode {
  EN
  TA
}

enum AccountState {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleCode {
  USER
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum VerificationType {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  REGISTER
  RESET_PASSWORD
}

enum VerificationState {
  PENDING
  VERIFIED
  EXPIRED
  CANCELLED
  ARCHIVED
}

model Account {
  id           String       @id @default(uuid()) @db.Uuid
  accountNo    String       @unique @db.VarChar(20)
  currentState AccountState @default(ACTIVE)
  tokenVersion Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations  AccountTranslation[]
  credential    AccountCredential?
  roles         AccountRole[]
  memberships   AccountMembership[]
  statusHistory AccountStatusHistory[]
  sessions      AccountSession[]

  @@index([accountNo])
  @@index([currentState])
  @@map("accounts")
}

model AccountTranslation {
  id         String       @id @default(uuid())
  accountId  String       @db.Uuid
  language   LanguageCode
  firstName String
  lastName  String?
  isDefault  Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, language])
  @@index([accountId])
  @@map("account_translations")
}

model AccountCredential {
  accountId        String    @id @db.Uuid
  email            String?   @unique @db.VarChar(255)
  phone            String?   @unique @db.VarChar(20)
  passwordHash     String?
  emailVerified    Boolean   @default(false)
  phoneVerified    Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([email])
  @@index([phone])
  @@map("account_credentials")
}

model Role {
  id   Int      @id @default(autoincrement())
  code RoleCode @unique

  accounts AccountRole[]

  @@map("roles")
}

model AccountRole {
  accountId  String   @db.Uuid
  roleId     Int
  assignedAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@id([accountId, roleId])
  @@map("account_roles")
}

model MembershipPlan {
  id          String             @id @default(uuid())
  code        String             @unique @db.VarChar(50)
  displayName String             @db.VarChar(100)
  price       Decimal            @db.Decimal(10, 2)
  currency    String             @default("INR") @db.VarChar(3)
  active      Boolean            @default(true)

  memberships AccountMembership[]

  @@map("membership_plans")
}

model AccountMembership {
  id        String           @id @default(uuid())
  accountId String           @db.Uuid
  planId    String
  planCode  String           @db.VarChar(50)
  planName  String           @db.VarChar(100)
  planPrice Decimal          @db.Decimal(10, 2)
  currency  String           @default("INR") @db.VarChar(3)
  startsAt  DateTime
  expiresAt DateTime?
  status    MembershipStatus @default(ACTIVE)

  account Account        @relation(fields: [accountId], references: [id])
  plan    MembershipPlan @relation(fields: [planId], references: [id])

  @@index([accountId])
  @@index([planId])
  @@map("account_memberships")
}

model AccountStatusHistory {
  id        String       @id @default(uuid())
  accountId String       @db.Uuid
  state     AccountState
  reason    String?
  changedBy String?      @db.VarChar(50)
  changedAt DateTime     @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, changedAt])
  @@map("account_status_history")
}

model AccountVerification {
  id         String             @id @default(uuid())
  accountId  String?
  type       VerificationType
  purpose    VerificationPurpose
  target     String             @db.VarChar(255)
  otpHash    String
  state      VerificationState  @default(PENDING)
  attempts   Int                @default(0)
  maxAttempts Int               @default(5)
  expiresAt  DateTime
  consumedAt DateTime?
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([target])
  @@index([state])
  @@index([expiresAt])
  @@index([target, purpose])
  @@map("account_verifications")
}

model AccountSession {
  id                String    @id @default(uuid())
  accountId         String    @db.Uuid
  refreshTokenHash  String
  tokenFamily       String    @db.VarChar(36)
  tokenVersion      Int       @default(0)
  userAgentHash     String?
  ipHash            String?
  deviceFingerprint String?
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(50)
  createdAt         DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("account_sessions")
}

model RegistrationSession {
  id              String   @id @default(uuid())
  verificationId  String
  snapshotTarget  String   @db.VarChar(255)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([verificationId])
  @@index([expiresAt])
  @@map("registration_sessions")
}

model ResetSession {
  id              String   @id @default(uuid())
  verificationId  String
  snapshotTarget  String   @db.VarChar(255)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([verificationId])
  @@index([expiresAt])
  @@map("reset_sessions")
}

model AccountNoCounter {
  id        Int      @id @default(autoincrement())
  prefix    String   @default("MKM") @db.VarChar(5)
  counter   Int      @default(0)

  @@unique([prefix])
  @@map("account_no_counters")
}
