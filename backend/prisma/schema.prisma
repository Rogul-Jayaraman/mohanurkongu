generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LanguageCode {
  EN
  TA
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum RoleCode {
  USER
  ADMIN
}

enum MembershipPlanCode {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SearchLevel {
  BASIC
  EXTENDED
  ADVANCED
  FULL
}

enum ViewDetails {
  BASIC
  EXTENDED
  ADVANCED
  FULL
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum BookingStatus {
  CONFIRMED
  EVENT_IN_PROGRESS
  EVENT_COMPLETED
  SETTLEMENT_PENDING
  COMPLETED
  CANCELLED
}

enum BookingMethod {
  NORMAL_BOOKING
  TOKEN_BOOKING
}

enum CalendarEntryStatus {
  AVAILABLE
  PARTIALLY_BOOKED
  FULLY_BOOKED
  BLOCKED
}

enum LedgerSource {
  PACKAGE
  ADDON
  SERVICE
  DISCOUNT
  DAMAGE
  PENALTY
  ADJUSTMENT
}

enum PaymentEntryType {
  ADVANCE
  INSTALLMENT
  FINAL_PAYMENT
}

enum RefundType {
  PARTIAL_REFUND
  FULL_REFUND
}

enum TokenState {
  ISSUED
  RESERVED
  CONSUMED
  REVERSED
}

enum TokenStatus {
  NOTUSED
  RESERVED
  USED
}

enum SettlementState {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InvoiceState {
  DRAFT
  GENERATED
  VOID
}

enum InvoiceLineType {
  PACKAGE
  ADDON
  SERVICE
  DAMAGE
  PENALTY
  ADJUSTMENT
  DISCOUNT
}

enum VerificationType {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  REGISTER
  RESET_PASSWORD
}

enum VerificationState {
  PENDING
  VERIFIED
  EXPIRED
  CANCELLED
  ARCHIVED
}

enum ProfileStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  ARCHIVED
  DELETED
}

enum UploadStatus {
  TEMP
  ATTACHED
  ACTIVE
  DELETE_PENDING
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReviewAction {
  APPROVED
  REJECTED
  UPDATE
  ARCHIVE
  RESTORE
  DELETE
}

enum Diet {
  VEGETARIAN
  NON_VEGETARIAN
  EGGETARIAN
  VEGAN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum Complexion {
  FAIR
  WHEATISH
  BROWN
  DARK
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  ANNULED
}

enum ResidenceType {
  OWNED
  RENTED
}

enum BookingType {
  HOURLY
  ONE_DAY
  TWO_DAY
}

enum EventType {
  MARRIAGE
  RECEPTION
  ENGAGEMENT
  BIRTHDAY
  BABY_SHOWER
  EAR_PIERCING
  PUBERTY_FUNCTION
  OTHER
}

enum DurationType {
  CUSTOM_HOURS
  FIXED_DAY
}

enum PricingType {
  HOURLY
  FIXED
}

enum AddonPricingType {
  ITEM
  PER_EVENT
  PER_HOUR
  PER_DAY
}


enum HoroscopeMode {
  GENERATED
  UPLOADED
}

model Account {
  id           String       @id @default(uuid()) @db.Uuid
  accountNo    String       @unique @db.VarChar(20)
  currentState AccountStatus @default(ACTIVE)
  tokenVersion Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations  AccountTranslation[]
  credential    AccountCredential?
  roles         AccountRole[]
  subscriptions         Subscription[]          @relation("SubscriptionAccount")
  adminAssignments      Subscription[]          @relation("SubscriptionAdmin")
  membershipUsage       MembershipUsage?
  profileOpens          ProfileOpen[]
  statusHistory         AccountStatusHistory[]
  sessions              AccountSession[]
  profiles              Profile[]
  uploads               Upload[]
  assignedVerifications VerificationQueue[]      @relation("assignedAdmin")
  reviewedReviews       ProfileReview[]
  auditEvents           AdminAuditEvent[]
  shortlists            Shortlist[]
  bookingCustomers      MandapamBooking[]       @relation("MandapamBookingCustomer")
  bookingCreators       MandapamBooking[]       @relation("MandapamBookingCreator")
  settlements           MandapamSettlement[]    @relation("MandapamSettlementAdmin")

  @@index([accountNo])
  @@index([currentState])
  @@index([createdAt])
  @@map("accounts")
}

model AccountTranslation {
  id        String       @id @default(uuid())
  accountId String       @db.Uuid
  language  LanguageCode
  firstName String
  lastName  String?
  isDefault Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, language])
  @@index([accountId])
  @@map("account_translations")
}

model AccountCredential {
  accountId        String    @id @db.Uuid
  email            String?   @unique @db.VarChar(255)
  phone            String?   @unique @db.VarChar(20)
  passwordHash     String?
  emailVerified    Boolean   @default(false)
  phoneVerified    Boolean   @default(false)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([email])
  @@index([phone])
  @@map("account_credentials")
}

model Role {
  id   Int      @id @default(autoincrement())
  code RoleCode @unique

  accounts AccountRole[]

  @@map("roles")
}

model AccountRole {
  accountId String      @db.Uuid
  roleId     Int
  assignedAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([accountId, roleId])
  @@map("account_roles")
}

model MembershipPlan {
  id          String   @id @default(uuid()) @db.Uuid
  code        MembershipPlanCode @unique
  displayName String   @db.VarChar(100)
  status      PlanStatus @default(ACTIVE)

  displayPrice Decimal @db.Decimal(10, 2)
  durationDays Int     @default(0)

  openLimit         Int @default(10)
  shortlistLimit    Int @default(0)
  profileSlotLimit  Int @default(1)

  viewDetails ViewDetails @default(BASIC)

  printProfile    Boolean @default(false)
  printHoroscope  Boolean @default(false)

  searchLevel SearchLevel @default(BASIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("membership_plans")
}

model Subscription {
  id        String           @id @default(uuid())
  accountId String           @db.Uuid
  planId    String           @db.Uuid
  status    MembershipStatus @default(ACTIVE)

  startedAt DateTime
  expiresAt DateTime?

  assignedByAdminId String? @db.Uuid

  paymentMethod PaymentMethod?

  snapshotPlanCode        MembershipPlanCode
  snapshotPlanName        String         @db.VarChar(100)
  snapshotDisplayPrice    Decimal        @db.Decimal(10, 2)
  snapshotDurationDays    Int            @default(0)

  snapshotOpenLimit        Int @default(10)
  snapshotShortlistLimit   Int @default(0)
  snapshotProfileSlotLimit Int @default(1)

  snapshotViewDetails ViewDetails @default(BASIC)

  snapshotPrintProfile   Boolean @default(false)
  snapshotPrintHoroscope Boolean @default(false)

  snapshotSearchLevel SearchLevel @default(BASIC)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account       Account        @relation("SubscriptionAccount", fields: [accountId], references: [id])
  plan          MembershipPlan @relation(fields: [planId], references: [id])
  assignedAdmin Account?       @relation("SubscriptionAdmin", fields: [assignedByAdminId], references: [id])

  profileOpens ProfileOpen[]
  usage        MembershipUsage?

  @@index([accountId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
  @@index([expiresAt, status])
  @@map("subscriptions")
}

model SystemSetting {
  key             String   @id @db.VarChar(100)
  value           String   @db.Text
  updatedAt       DateTime @updatedAt
  updatedByAdminId String? @db.Uuid

  @@map("system_settings")
}

model MembershipUsage {
  id             String @id @default(uuid())
  accountId      String @unique @db.Uuid
  subscriptionId String @unique

  openUsed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account      Account      @relation(fields: [accountId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("membership_usage")
}

model ProfileOpen {
  id               String   @id @default(uuid())
  viewerAccountId  String   @db.Uuid
  profileId        String   @db.Uuid
  openedAt         DateTime @default(now())
  subscriptionId   String

  viewerAccount Account     @relation(fields: [viewerAccountId], references: [id], onDelete: Cascade)
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subscription  Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([viewerAccountId, profileId])
  @@index([viewerAccountId])
  @@index([profileId])
  @@index([subscriptionId])
  @@map("profile_opens")
}

model AccountStatusHistory {
  id        String       @id @default(uuid())
  accountId String?      @db.Uuid
  state     AccountStatus
  reason    String?
  changedBy String?      @db.VarChar(50)
  changedAt DateTime     @default(now())

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, changedAt])
  @@map("account_status_history")
}

model AccountVerification {
  id          String              @id @default(uuid())
  accountId   String?
  type        VerificationType
  purpose     VerificationPurpose
  target      String              @db.VarChar(255)
  otpHash     String
  state       VerificationState   @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([target])
  @@index([state])
  @@index([expiresAt])
  @@index([target, purpose])
  @@map("account_verifications")
}

model AccountSession {
  id                String    @id @default(uuid())
  accountId         String    @db.Uuid
  refreshTokenHash  String    @unique
  tokenFamily       String    @db.VarChar(36)
  tokenVersion      Int       @default(0)
  userAgentHash     String?
  ipHash            String?
  deviceFingerprint String?
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(50)
  createdAt         DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("account_sessions")
}

model RegistrationSession {
  id             String    @id @default(uuid())
  verificationId String
  snapshotTarget String    @db.VarChar(255)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([verificationId])
  @@index([expiresAt])
  @@map("registration_sessions")
}

model ResetSession {
  id             String    @id @default(uuid())
  verificationId String
  snapshotTarget String    @db.VarChar(255)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([verificationId])
  @@index([expiresAt])
  @@map("reset_sessions")
}

model Counter {
  id      Int    @id @default(autoincrement())
  prefix  String @unique @db.VarChar(10)
  counter Int    @default(0)

  @@map("counters")
}

model Upload {
  id                 String       @id @default(uuid()) @db.Uuid
  publicId           String       @unique @db.VarChar(16)    // kept until Phase 10 cleanup
  uploadToken        String?      @unique @db.VarChar(32)    // nullable for Phase 2 backfill
  ownerAccountId     String       @db.Uuid
  objectKey          String
  originalFileName   String       // kept until Phase 10 cleanup
  mimeType           String       // kept until Phase 10 cleanup
  extension          String       // kept until Phase 10 cleanup
  size               Int
  checksum           String
  status             UploadStatus @default(TEMP)
  lastAccessedAt     DateTime?    // kept until Phase 10 cleanup
  version            Int          @default(1)
  width              Int?
  height             Int?
  cleanupAttempts    Int          @default(0)
  cleanupLastError   String?      @db.Text
  cleanupAbandonedAt DateTime?
  deletedAt          DateTime?
  attachedEntityType String?      @db.VarChar(30)
  attachedEntityId   String?      @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  owner Account @relation(fields: [ownerAccountId], references: [id])

  rasiChartProfiles    ProfileHoroscope[]    @relation("RasiChart")
  navamsaChartProfiles ProfileHoroscope[]    @relation("NavamsaChart")
  primaryPhoto         ProfilePhoto?
  galleryPhotos        ProfileGalleryPhoto[]

  @@index([ownerAccountId])
  @@index([status])
  @@index([publicId])
  @@index([status, updatedAt])
  @@index([status, createdAt])
  @@index([status, lastAccessedAt])
  @@index([attachedEntityId, status])
  @@index([status, cleanupAttempts])
  @@map("uploads")
}

model PublishLog {
  id              String   @id @default(uuid()) @db.Uuid
  idempotencyKey  String   @unique
  profileId       String   @db.Uuid
  regNo           String
  accountId       String   @db.Uuid
  createdAt       DateTime @default(now())

  @@index([accountId])
  @@map("publish_logs")
}

model ProfileFor {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(50)

  basics ProfileBasic[]

  @@map("profile_fors")
}

model Community {
  id   Int    @id @default(autoincrement())
  code String @unique

  castes   Caste[]
  profiles ProfileCommunity[]

  @@map("communities")
}

model Caste {
  id          Int    @id @default(autoincrement())
  code        String
  communityId Int

  community Community @relation(fields: [communityId], references: [id])
  profiles  ProfileCommunity[]

  @@unique([communityId, code])
  @@map("castes")
}

model Height {
  id      Int  @id @default(autoincrement())
  valueCm Int  @unique
  label   String

  basicProfiles         ProfileBasic[]
  partnerMinPreferences PartnerPreference[] @relation("PartnerMinHeight")
  partnerMaxPreferences PartnerPreference[] @relation("PartnerMaxHeight")

  @@map("heights")
}

model JobSector {
  id   Int    @id @default(autoincrement())
  code String @unique

  profiles ProfileProfessional[]

  @@map("job_sectors")
}

model District {
  id   Int    @id @default(autoincrement())
  code String @unique

  taluks    Taluk[]
  locations Location[]

  @@map("districts")
}

model Taluk {
  id         Int    @id @default(autoincrement())
  code       String
  districtId Int

  district  District   @relation(fields: [districtId], references: [id])
  locations Location[]

  @@unique([districtId, code])
  @@map("taluks")
}

model Kulam {
  id   Int    @id @default(autoincrement())
  code String @unique

  profiles ProfileCommunity[]

  @@map("kulams")
}

model Rasi {
  id   Int    @id @default(autoincrement())
  code String @unique

  profiles ProfileHoroscope[]

  @@map("risis")
}

model Nakshatra {
  id   Int    @id @default(autoincrement())
  code String @unique

  profiles ProfileHoroscope[]

  @@map("nakshatras")
}

model Lagna {
  id   Int    @id @default(autoincrement())
  code String @unique

  profiles ProfileHoroscope[]

  @@map("lagnas")
}

model Location {
  id         String   @id @default(uuid()) @db.Uuid
  isOther    Boolean  @default(false)
  districtId Int?
  talukId    Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district District? @relation(fields: [districtId], references: [id])
  taluk    Taluk?    @relation(fields: [talukId], references: [id])

  currentLocationProfiles ProfileBasic[] @relation("CurrentLocation")
  nativeLocationProfiles  ProfileBasic[] @relation("NativeLocation")

  @@index([districtId])
  @@index([talukId])
  @@index([isOther])
  @@map("locations")
}

model Profile {
  id            String        @id @default(uuid()) @db.Uuid
  accountId     String        @db.Uuid
  regNo         String?       @unique
  currentStatus     ProfileStatus
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  activatedAt       DateTime?
  archivedAt        DateTime?
  approvedAt        DateTime?
  approvedBy        String?        @db.Uuid
  rejectedAt        DateTime?
  rejectedBy        String?        @db.Uuid
  rejectionReasonEn String?
  rejectionReasonTa String?
  archiveReasonEn   String?
  archiveReasonTa   String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  basic             ProfileBasic?
  community         ProfileCommunity?
  professional      ProfileProfessional?
  family            ProfileFamily?
  horoscope         ProfileHoroscope?
  photo             ProfilePhoto?
  assets            ProfileAssets?
  partnerPreference PartnerPreference?
  translations      ProfileTranslation[]
  history           ProfileStateHistory[]
  verificationQueue VerificationQueue?
  reviews           ProfileReview[]
  shortlists        Shortlist[]
  profileOpens      ProfileOpen[]

  @@index([accountId])
  @@index([currentStatus])
  @@index([createdAt])
  @@map("profiles")
}

model ProfileBasic {
  id                String         @id @default(uuid()) @db.Uuid
  profileId         String         @unique @db.Uuid
  profileForId      Int
  gender            Gender
  dob               DateTime
  diet              Diet
  bloodGroup        BloodGroup?
  heightId          Int
  weight            Int?
  complexion        Complexion?
  maritalStatus     MaritalStatus?
  currentLocationId String?        @db.Uuid
  nativeLocationId  String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  profile         Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileFor      ProfileFor @relation(fields: [profileForId], references: [id])
  height          Height     @relation(fields: [heightId], references: [id])
  currentLocation Location?  @relation("CurrentLocation", fields: [currentLocationId], references: [id])
  nativeLocation  Location?  @relation("NativeLocation", fields: [nativeLocationId], references: [id])

  @@index([gender])
  @@index([dob])
  @@index([gender, dob])
  @@index([heightId])
  @@index([currentLocationId])
  @@index([nativeLocationId])
  @@index([maritalStatus])
  @@map("profile_basic")
}

model ProfileCommunity {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @unique @db.Uuid
  communityId Int
  casteId     Int
  kulamId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id])
  caste     Caste     @relation(fields: [casteId], references: [id])
  kulam     Kulam?    @relation(fields: [kulamId], references: [id])

  @@index([communityId, casteId])
  @@index([kulamId])
  @@map("profile_communities")
}

model ProfileProfessional {
  id             String   @id @default(uuid()) @db.Uuid
  profileId      String   @unique @db.Uuid
  education      String?
  jobSectorId    Int?
  jobDetail      String?
  jobLocation    String?
  monthlySalary  Decimal? @db.Decimal(12, 2)
  salaryCurrency String?  @default("INR")
  companyName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobSector JobSector? @relation(fields: [jobSectorId], references: [id])

  @@index([jobSectorId])
  @@index([monthlySalary])
  @@index([jobLocation])
  @@map("profile_professional")
}

model ProfileFamily {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @unique @db.Uuid
  fatherAlive  Boolean
  fatherName   String?
  fatherJob    String?
  fatherSalary Int?
  motherAlive  Boolean
  motherName   String?
  motherJob    String?
  motherSalary Int?
  noOfBrother  Int?
  noOfSister   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_family")
}

model ProfileHoroscope {
  id                   String        @id @default(uuid()) @db.Uuid
  profileId            String        @unique @db.Uuid
  mode                 HoroscopeMode
  horoscopeJson        Json?         @db.JsonB
  generatedAt          DateTime?
  rasiId               Int?
  nakshatraId          Int?
  lagnaId              Int?
  rasiChartUploadId    String?       @db.Uuid
  navamsaChartUploadId String?       @db.Uuid
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rasi         Rasi?      @relation(fields: [rasiId], references: [id])
  nakshatra    Nakshatra? @relation(fields: [nakshatraId], references: [id])
  lagna        Lagna?     @relation(fields: [lagnaId], references: [id])
  rasiChart    Upload?    @relation("RasiChart", fields: [rasiChartUploadId], references: [id])
  navamsaChart Upload?    @relation("NavamsaChart", fields: [navamsaChartUploadId], references: [id])

  @@index([rasiId])
  @@index([nakshatraId])
  @@index([lagnaId])
  @@map("profile_horoscopes")
}

model ProfilePhoto {
  id              String   @id @default(uuid()) @db.Uuid
  profileId       String   @unique @db.Uuid
  primaryUploadId String?  @unique @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile       Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  primaryUpload Upload?               @relation(fields: [primaryUploadId], references: [id])
  gallery       ProfileGalleryPhoto[]

  @@map("profile_photos")
}

model ProfileGalleryPhoto {
  id             String @id @default(uuid()) @db.Uuid
  profilePhotoId String @db.Uuid
  uploadId       String @db.Uuid

  profilePhoto ProfilePhoto @relation(fields: [profilePhotoId], references: [id], onDelete: Cascade)
  upload       Upload       @relation(fields: [uploadId], references: [id])

  @@unique([profilePhotoId, uploadId])
  @@index([uploadId])
  @@map("profile_gallery_photos")
}

model ProfileAssets {
  id            String         @id @default(uuid()) @db.Uuid
  profileId     String         @unique @db.Uuid
  land          String?
  residenceType ResidenceType?
  otherAssets   String?
  vehicle       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("profile_assets")
}

model PartnerPreference {
  id              String   @id @default(uuid()) @db.Uuid
  profileId       String   @unique @db.Uuid
  ageMin          Int?
  ageMax          Int?
  heightMinId     Int?
  heightMaxId     Int?
  monthlySalary   Decimal? @db.Decimal(12, 2)
  salaryCurrency  String?  @default("INR")
  expectationNote String?
  preferredLocation String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  heightMin Height? @relation("PartnerMinHeight", fields: [heightMinId], references: [id])
  heightMax Height? @relation("PartnerMaxHeight", fields: [heightMaxId], references: [id])

  @@map("partner_preferences")
}

model ProfileTranslation {
  id              String       @id @default(uuid()) @db.Uuid
  profileId       String       @db.Uuid
  language        LanguageCode
  firstName       String?
  lastName        String?
  kuladeivam      String?
  fatherName      String?
  motherName      String?
  jobLocation     String?
  currentCity     String?
  currentState    String?
  currentCountry  String?
  nativeCity      String?
  nativeState     String?
  nativeCountry   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, language])
  @@map("profile_translations")
}

model ProfileStateHistory {
  id                 String         @id @default(uuid()) @db.Uuid
  profileId          String         @db.Uuid
  changedByAccountId String?        @db.Uuid
  fromStatus         ProfileStatus?
  toStatus           ProfileStatus
  reason             String?
  metadata           Json?
  createdAt          DateTime       @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("profile_state_history")
}

model VerificationQueue {
  id         String    @id @default(uuid()) @db.Uuid
  profileId  String    @unique @db.Uuid
  assignedTo String?   @db.Uuid
  claimedAt  DateTime?
  completedAt DateTime?
  lockedAt   DateTime?
  lockedBy   String?   @db.Uuid
  priority   Int       @default(0)
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignee Account? @relation("assignedAdmin", fields: [assignedTo], references: [id])

  @@index([assignedTo])
  @@index([completedAt])
  @@index([createdAt])
  @@map("verification_queue")
}

model ProfileReview {
  id         String       @id @default(uuid()) @db.Uuid
  profileId  String       @db.Uuid
  reviewerId String       @db.Uuid
  action     ReviewAction
  reasonEn   String?      @db.VarChar(500)
  reasonTa   String?      @db.VarChar(500)
  reviewData Json?
  createdAt  DateTime     @default(now())

  profile  Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reviewer Account @relation(fields: [reviewerId], references: [id])

  @@index([profileId, createdAt])
  @@index([createdAt])
  @@index([reviewerId])
  @@map("profile_reviews")
}

model Shortlist {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  accountId String   @db.Uuid
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([profileId, accountId])
  @@index([accountId])
  @@index([accountId, createdAt])
  @@index([profileId])
  @@map("shortlists")
}

model AdminAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  profileId String?  @db.Uuid
  action    String   @db.VarChar(30)
  metadata  Json?
  ipAddress String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  actor Account @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([profileId, createdAt])
  @@map("admin_audit_events")
}

// ═══════════════════════════════════════════════════════════════
// Mandapam — Bookings
// ═══════════════════════════════════════════════════════════════

model MandapamBooking {
  id            String        @id @default(uuid()) @db.Uuid
  bookingNo     String        @unique @db.VarChar(20)
  customerId    String        @db.Uuid
  customerName  Json          @db.JsonB
  customerPhone String        @db.VarChar(20)
  customerEmail String?       @db.VarChar(255)
  eventTitle    Json          @db.JsonB
  eventAddress  Json?         @db.JsonB
  status        BookingStatus @default(CONFIRMED)
  bookingMethod BookingMethod @default(NORMAL_BOOKING)
  bookingType   BookingType
  eventType     EventType     @default(OTHER)
  packageCode   String        @db.VarChar(50)
  bookingConfig Json          @db.JsonB
  notes         String?       @db.Text
  createdBy     String        @db.Uuid
  customer      Account       @relation("MandapamBookingCustomer", fields: [customerId], references: [id])
  creator       Account       @relation("MandapamBookingCreator", fields: [createdBy], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  packageSnapshot MandapamBookingPackageSnapshot?
  addonSnapshots  MandapamBookingAddonSnapshot[]
  calendarEntries MandapamCalendarEntry[]
  ledgerEntries   MandapamFinancialLedger[]
  paymentEntries  MandapamPaymentLedger[]
  refundEntries   MandapamRefundLedger[]
  tokenEntries    MandapamTokenConsumption[]
  tokens          MandapamToken[]
  settlement      MandapamSettlement?
  timeline        MandapamBookingTimeline[]
  invoice         MandapamInvoice?
  auditLogs       MandapamAuditLog[]

  @@index([status])
  @@index([packageCode])
  @@index([createdAt])
  @@index([customerId])
  @@index([createdBy])
  @@index([status, createdAt])
  @@map("mandapam_bookings")
}

model MandapamBookingPackageSnapshot {
  id             String    @id @default(uuid()) @db.Uuid
  bookingId      String    @unique @db.Uuid
  packageId      String    @db.Uuid
  packageCode    String    @db.VarChar(50)
  packageName    Json      @db.JsonB
  packagePrice   Decimal   @db.Decimal(12, 2)
  packageVersion Int       @default(1)
  createdAt      DateTime  @default(now())

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("mandapam_booking_package_snapshots")
}

model MandapamBookingAddonSnapshot {
  id           String           @id @default(uuid()) @db.Uuid
  bookingId    String           @db.Uuid
  addonId      String           @db.Uuid
  addonName    Json             @db.JsonB
  pricingType  AddonPricingType @default(PER_EVENT)
  quantity     Int?
  units        Int?
  amount       Decimal          @db.Decimal(12, 2)
  createdAt    DateTime         @default(now())

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("mandapam_booking_addon_snapshots")
}

model MandapamCalendarEntry {
  id        String              @id @default(uuid()) @db.Uuid
  date      DateTime
  startTime DateTime?           @db.Time
  endTime   DateTime?           @db.Time
  status    CalendarEntryStatus @default(AVAILABLE)
  reasonEn  String?             @db.VarChar(500)
  reasonTa  String?             @db.VarChar(500)
  bookingId String?             @db.Uuid
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  booking MandapamBooking? @relation(fields: [bookingId], references: [id])

  @@index([date])
  @@index([date, status])
  @@index([status])
  @@index([bookingId])
  @@map("mandapam_calendar_entries")
}

model MandapamFinancialLedger {
  id           String       @id @default(uuid()) @db.Uuid
  bookingId    String       @db.Uuid
  source       LedgerSource
  description  Json?        @db.JsonB
  amount       Decimal      @db.Decimal(12, 2)
  currencyCode String       @db.VarChar(10) @default("INR")
  createdAt    DateTime     @default(now())

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([source])
  @@index([createdAt])
  @@map("mandapam_financial_ledgers")
}

model MandapamPaymentLedger {
  id            String          @id @default(uuid()) @db.Uuid
  bookingId     String          @db.Uuid
  paymentType   PaymentEntryType
  paymentMethod PaymentMethod
  amount        Decimal         @db.Decimal(12, 2)
  referenceNo   String?         @db.VarChar(100)
  receivedAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([paymentType])
  @@map("mandapam_payment_ledgers")
}

model MandapamRefundLedger {
  id           String       @id @default(uuid()) @db.Uuid
  bookingId    String       @db.Uuid
  refundType   RefundType
  refundMethod PaymentMethod?
  amount       Decimal      @db.Decimal(12, 2)
  reason       String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("mandapam_refund_ledgers")
}

model MandapamTokenConsumption {
  id          String      @id @default(uuid()) @db.Uuid
  bookingId   String      @db.Uuid
  tokens      Int
  state       TokenState  @default(CONSUMED)
  consumedAt  DateTime    @default(now())
  reversedAt  DateTime?

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("mandapam_token_consumptions")
}

model MandapamToken {
  id        String      @id @default(uuid()) @db.Uuid
  tokenId   String      @unique @db.VarChar(20)
  status    TokenStatus @default(NOTUSED)
  bookingId String?     @db.Uuid
  booking   MandapamBooking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@map("mandapam_tokens")
}

model MandapamSettlement {
  id            String          @id @default(uuid()) @db.Uuid
  bookingId     String          @unique @db.Uuid
  state         SettlementState @default(PENDING)
  damageCharges Json?           @db.JsonB
  penaltyCharges Json?          @db.JsonB
  extraCharges  Json?           @db.JsonB
  finalAmount   Decimal?        @db.Decimal(12, 2)
  settledAt     DateTime?
  settledBy     String?         @db.Uuid
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  settledByAdmin Account?  @relation("MandapamSettlementAdmin", fields: [settledBy], references: [id])

  @@index([settledBy])
  @@map("mandapam_settlements")
}

model MandapamInvoice {
  id          String       @id @default(uuid()) @db.Uuid
  bookingId   String       @unique @db.Uuid
  invoiceNo   String       @unique @db.VarChar(20)
  state       InvoiceState @default(DRAFT)
  issuedAt    DateTime?
  cancelledAt DateTime?
  voidReason  String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lines   MandapamInvoiceLine[]

  @@index([invoiceNo])
  @@map("mandapam_invoices")
}

model MandapamInvoiceLine {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @db.Uuid
  lineType    InvoiceLineType
  description Json?           @db.JsonB
  amount      Decimal         @db.Decimal(12, 2)
  quantity    Int             @default(1)
  createdAt   DateTime        @default(now())

  invoice MandapamInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("mandapam_invoice_lines")
}

model MandapamBookingTimeline {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  event     String   @db.VarChar(50)
  metadata  Json?    @db.JsonB
  notes     String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("mandapam_booking_timelines")
}

model MandapamAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String   @db.Uuid
  action       String   @db.VarChar(50)
  performedBy  String   @db.Uuid
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now())

  booking MandapamBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([performedBy])
  @@map("mandapam_audit_logs")
}

// ═══════════════════════════════════════════════════════════════
// Mandapam — Package Management
// ═══════════════════════════════════════════════════════════════

model MandapamPackage {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique @db.VarChar(50)
  bookingType   BookingType
  durationType  DurationType
  durationValue Int?
  tokenCount    Int          @default(0)
  status        Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations MandapamPackageTranslation[]
  functions    MandapamPackageFunction[]
  pricings     MandapamPackagePricing[]

  @@index([code])
  @@map("mandapam_packages")
}

model MandapamPackageTranslation {
  id          String       @id @default(uuid()) @db.Uuid
  packageId   String       @db.Uuid
  language    LanguageCode
  displayName String       @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package MandapamPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, language])
  @@map("mandapam_package_translations")
}

model MandapamPackageFunction {
  id        String  @id @default(uuid()) @db.Uuid
  packageId String  @db.Uuid
  status    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package      MandapamPackage                    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  translations MandapamPackageFunctionTranslation[]

  @@index([packageId])
  @@map("mandapam_package_functions")
}

model MandapamPackageFunctionTranslation {
  id         String       @id @default(uuid()) @db.Uuid
  functionId String       @db.Uuid
  language   LanguageCode
  name       String       @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  function MandapamPackageFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([functionId, language])
  @@map("mandapam_package_function_translations")
}

model MandapamPackagePricing {
  id            String       @id @default(uuid()) @db.Uuid
  packageId     String       @db.Uuid
  pricingType   PricingType
  amount        Decimal      @db.Decimal(12, 2)
  currencyCode  String       @db.VarChar(10) @default("INR")
  isActive      Boolean      @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package MandapamPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([packageId, isActive])
  @@map("mandapam_package_pricings")
}

model MandapamFacility {
  id       String   @id @default(uuid()) @db.Uuid
  iconName String   @db.VarChar(100)
  status   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations MandapamFacilityTranslation[]

  @@map("mandapam_facilities")
}

model MandapamFacilityTranslation {
  id         String       @id @default(uuid()) @db.Uuid
  facilityId String       @db.Uuid
  language   LanguageCode
  name       String       @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility MandapamFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, language])
  @@map("mandapam_facility_translations")
}

model MandapamAddonService {
  id               String           @id @default(uuid()) @db.Uuid
  iconName         String           @db.VarChar(100)
  pricingType      AddonPricingType @default(PER_EVENT)
  supportsQuantity Boolean          @default(false)
  status           Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations MandapamAddonServiceTranslation[]

  @@map("mandapam_addon_services")
}

model MandapamAddonServiceTranslation {
  id      String       @id @default(uuid()) @db.Uuid
  addonId String       @db.Uuid
  language LanguageCode
  name     String       @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addonService MandapamAddonService @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([addonId, language])
  @@map("mandapam_addon_service_translations")
}
